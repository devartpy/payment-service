@startuml
title Payment consumer — целевой процесс

start
:Получить исходное сообщение из payments.new;
:Прочитать Payment по payment_id;

if (Статус PENDING?) then (да)
  :Эмулировать платёж\n(случайная задержка 2–5 секунд и исход 90/10);
  if (Платёж успешен?) then (да, 90%)
    :Сохранить SUCCEEDED (конечный)\nи дату обработки;
  else (нет, 10%)
    :Сохранить FAILED (конечный)\nи дату обработки;
  endif
else (SUCCEEDED или FAILED)
  :Пропустить вызов шлюза;
endif

:Опубликовать задачу attempt=1 в webhook.ready;
:Дождаться publisher confirm и ack payments.new;
:Subscriber webhook.ready читает Payment из БД;
:Отправить один HTTP POST webhook;
if (Ответ 200 OK?) then (да)
  :ack задачи webhook;
else (нет)
  if (Временная ошибка и attempt < 3?) then (да)
    :Опубликовать attempt+1 в очередь TTL 1 или 2 с;
    :Дождаться confirm и ack текущей задачи;
    :RabbitMQ вернёт задачу в webhook.ready через DLX;
  else (окончательный отказ)
    :reject(requeue=false) задачи webhook;
    :RabbitMQ переводит её в payments.dead_letter;
    :Сообщение остаётся в DLQ для разбора;
  endif
endif
stop
@enduml
