@startuml
!include <C4/C4_Container>

title payment-service — целевая архитектура (C4 Container)
LAYOUT_LEFT_RIGHT()

Person(client, "Клиент API", "Создаёт платежи и запрашивает их состояние")
System_Ext(gateway, "Платёжный шлюз", "Внешняя зависимость; на данном этапе эмулируется")
System_Ext(webhook, "Система клиента", "Получает уведомления на webhook URL")

System_Boundary(service, "payment-service") {
  Container(api, "Payment API", "FastAPI, Pydantic", "Создаёт Payment (NEW) и OutboxEvent в одной транзакции")
  ContainerDb(db, "Хранилище платежей", "PostgreSQL", "Таблицы payments и outbox")
  Container(relay, "Outbox publisher", "Python; логическая роль", "Публикует событие; после подтверждения переводит NEW в PENDING и удаляет OutboxEvent")
  ContainerQueue(broker, "Брокер сообщений", "RabbitMQ", "Очереди payments.new и payments.dlq; DLX направляет отклонённые сообщения в DLQ")
  Container(consumer, "Payment consumer", "FastStream, Python", "Проверяет статус, эмулирует платёж и отправляет webhook")
}

Rel(client, api, "Создаёт и запрашивает платежи", "HTTP API")
Rel(api, db, "Читает платежи; атомарно сохраняет Payment (NEW) и OutboxEvent", "SQLAlchemy")
Rel(relay, db, "Читает outbox; после подтверждения меняет статус на PENDING и удаляет событие", "SQLAlchemy")
Rel(relay, broker, "Публикует payments.new; ждёт подтверждения", "RabbitMQ")
Rel(broker, consumer, "Доставляет исходное сообщение из payments.new", "RabbitMQ")
Rel(consumer, db, "Проверяет статус; сохраняет SUCCEEDED или FAILED и дату обработки", "SQLAlchemy")
Rel(consumer, gateway, "При PENDING эмулирует платёж с Idempotency-Key")
Rel(consumer, webhook, "Отправляет результат; до 3 попыток при сети, таймауте или 5xx", "HTTP webhook")
Rel(consumer, broker, "При NEW возвращает сообщение в очередь; после 200 подтверждает; при 4xx или исчерпании попыток отклоняет в payments.dlq", "RabbitMQ")

@enduml
